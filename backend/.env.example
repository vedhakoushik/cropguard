# Local development only. On AWS set SECRET_ID and keep values in Secrets Manager.
# SECRET_ID=cropguard/prod
AWS_REGION=us-east-1

SECRET_KEY=change-me
GEMINI_API_KEY=your_gemini_api_key

DB_HOST=localhost
DB_PORT=5432
DB_NAME=cropguard
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_SSLMODE=prefer

S3_BUCKET=cropguard-images-yourname
COGNITO_CLIENT_ID=your_cognito_app_client_id

DEBUG=true
MAX_IMAGE_MB=10
